[
  { "name": "projects", "path": "/projects" },
  { "name": "projects-create", "path": "/projects", "steps": [{ "click": "text=Create project" }] },
  { "name": "user-menu", "path": "/projects", "steps": [{ "click": "text=Amy Admin" }] },
  { "name": "mfa-required", "path": "/mfa_required" },

  { "name": "workflows", "path": "/projects/{{P}}/w" },
  { "name": "project-picker", "path": "/projects/{{P}}/w", "steps": [{ "click": "button:has-text('openhie-project')", "sleep": 1000 }] },
  { "name": "workflow-new", "path": "/projects/{{P}}/w", "steps": [{ "click": "text=Create new workflow", "sleep": 2500 }] },
  { "name": "workflow-templates", "path": "/projects/{{P}}/w/new", "steps": [{ "click": "text=Browse templates", "sleep": 2500 }] },
  { "name": "workflow-health", "path": "/projects/{{P}}/w/wf-openhie/health", "lpath": "/projects/{{P}}/w/{{LW}}/health" },

  { "name": "editor", "path": "/projects/{{P}}/w/wf-openhie", "lpath": "/projects/{{P}}/w/{{LW}}", "lwait": 5000 },
  { "name": "editor-job", "path": "/projects/{{P}}/w/wf-openhie", "lpath": "/projects/{{P}}/w/{{LW}}", "lwait": 5000, "steps": [{ "mouse": [808, 396], "sleep": 1500 }] },
  { "name": "editor-trigger", "path": "/projects/{{P}}/w/wf-openhie", "lpath": "/projects/{{P}}/w/{{LW}}", "lwait": 5000, "steps": [{ "mouse": [808, 212], "sleep": 1500 }] },
  { "name": "editor-edge", "path": "/projects/{{P}}/w/wf-openhie", "lpath": "/projects/{{P}}/w/{{LW}}", "lwait": 5000, "steps": [{ "mouse": [810, 488], "sleep": 1500 }] },
  { "name": "editor-history", "path": "/projects/{{P}}/w/wf-openhie", "lpath": "/projects/{{P}}/w/{{LW}}", "lwait": 5000, "steps": [{ "click": "text=View History", "sleep": 1500 }] },
  { "name": "editor-run-menu", "path": "/projects/{{P}}/w/wf-openhie", "lpath": "/projects/{{P}}/w/{{LW}}", "lwait": 5000, "steps": [{ "click": "button[aria-label='Open run options'], button:has-text('Open run options')", "sleep": 1200 }] },
  { "name": "editor-versions", "path": "/projects/{{P}}/w/wf-openhie", "lpath": "/projects/{{P}}/w/{{LW}}", "lwait": 5000, "steps": [{ "click": "text=latest >> nth=0", "sleep": 1200 }] },
  { "name": "editor-run", "path": "/projects/{{P}}/w/wf-openhie?run=run-1", "lpath": "/projects/{{P}}/w/{{LW}}?run={{LRUN}}", "lwait": 6000 },
  { "name": "editor-ide", "path": "/projects/{{P}}/w/wf-openhie?job=job-transform&panel=editor", "lpath": "/projects/{{P}}/w/{{LW}}?job={{LJOB}}&panel=editor", "lwait": 6000 },
  { "name": "editor-ide-run", "path": "/projects/{{P}}/w/wf-openhie?run=run-1&panel=editor&job=job-transform", "lpath": "/projects/{{P}}/w/{{LW}}?run={{LRUN}}&panel=editor&job={{LJOB}}", "lwait": 6000 },

  { "name": "history", "path": "/projects/{{P}}/history" },
  { "name": "history-expand", "path": "/projects/{{P}}/history", "steps": [{ "click": "tbody tr >> nth=0 >> .hero-chevron-down", "sleep": 1200 }] },
  { "name": "history-filter", "path": "/projects/{{P}}/history", "steps": [{ "click": "text=Workflow is any" }] },
  { "name": "history-select-all", "path": "/projects/{{P}}/history", "steps": [{ "click": "thead input[type=checkbox]", "sleep": 1000 }] },
  { "name": "run", "path": "/projects/{{P}}/runs/run-1", "lpath": "/projects/{{P}}/runs/{{LRUN}}" },

  { "name": "sandboxes", "path": "/projects/{{P}}/sandboxes" },
  { "name": "sandboxes-create", "path": "/projects/{{P}}/sandboxes", "steps": [{ "click": "text=Create Sandbox", "sleep": 1500 }] },
  { "name": "channels", "path": "/projects/{{P}}/channels" },

  { "name": "settings-setup", "path": "/projects/{{P}}/settings" },
  { "name": "settings-setup-save", "path": "/projects/{{P}}/settings", "steps": [{ "click": "button:has-text('Save') >> nth=0", "sleep": 500 }] },
  { "name": "settings-credentials", "path": "/projects/{{P}}/settings#credentials" },
  { "name": "settings-collections", "path": "/projects/{{P}}/settings#collections" },
  { "name": "settings-webhook-security", "path": "/projects/{{P}}/settings#webhook_security" },
  { "name": "settings-collaboration", "path": "/projects/{{P}}/settings#collaboration" },
  { "name": "settings-collaboration-add", "path": "/projects/{{P}}/settings#collaboration", "steps": [{ "click": "text=Add Collaborator(s)", "sleep": 1200 }] },
  { "name": "settings-security", "path": "/projects/{{P}}/settings#security" },
  { "name": "settings-vcs", "path": "/projects/{{P}}/settings#vcs" },
  { "name": "settings-data-storage", "path": "/projects/{{P}}/settings#data-storage" },
  { "name": "settings-history-exports", "path": "/projects/{{P}}/settings#history-exports" },

  { "name": "credentials", "path": "/credentials" },
  { "name": "credentials-add-new", "path": "/credentials", "steps": [{ "click": "text=Add new" }] },
  { "name": "credentials-actions", "path": "/credentials", "lsteps": [{ "click": "button:has-text('Actions') >> nth=0" }], "rsteps": [{ "click": "button:has-text('Actions') >> nth=1" }] },
  { "name": "profile", "path": "/profile" },
  { "name": "profile-lower", "path": "/profile", "steps": [{ "wheel": 1600 }] },
  { "name": "tokens", "path": "/profile/tokens" },
  { "name": "tokens-create", "path": "/profile/tokens", "steps": [{ "click": "text=Generate New Token >> nth=0", "sleep": 500 }] }
]
